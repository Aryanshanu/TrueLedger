# Copy to .env and fill in for local development.
# The backend and infra scripts read these via os.environ (see agents/config.py).

# Cloud Run / Artifact Registry deploy region. NOT the Vertex AI call
# location - see VERTEX_AI_LOCATION below.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1

# Vertex AI ("Gemini Enterprise Agent Platform") call location, passed
# explicitly via client_kwargs in agents/config.py - see the comment there
# for why. "global" is confirmed correct from Google's own Gemini 3.8 Flash
# sample code; override only if a specific model tier isn't served there.
VERTEX_AI_LOCATION=global

# SPECIALIST_MODEL is CONFIRMED (Sept 2026 Model Garden page). ORCHESTRATOR_MODEL
# is still a placeholder - confirm against its own Model Garden page before
# relying on it. See docs/ARCHITECTURE.md "Flagged: exact Gemini model IDs".
SPECIALIST_MODEL=gemini-3.8-flash
ORCHESTRATOR_MODEL=gemini-3.1-pro

# frontend/server.js only - the Cloud Run URL of the deployed backend.
BACKEND_URL=http://localhost:8081
