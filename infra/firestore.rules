// All reads/writes go through the backend Cloud Run service using the
// google-cloud-firestore server SDK (a service account), which is not
// subject to these rules. No client (browser) ever talks to Firestore
// directly in this architecture, so client access is fully denied here.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
